# Copy to .env (git-ignored). Placeholder names only — never commit real values (CLAUDE.md §11.7).
C2_ENV=local
C2_GCP_PROJECT_ID=
C2_GCP_REGION=

# OCR (plan §4.1; ADR-0017). none = scans wait in review unread · documentai = live, cached by file hash
# in data/synthetic/mock_v1/ocr/documentai/<version>/ · recorded = replay that cache only (no GCP calls)
C2_OCR_PROVIDER=none
C2_DOCAI_LOCATION=
C2_DOCAI_OCR_PROCESSOR_ID=
# Pin the OCR model (ADR-0017): the processor default (v1.0, 2020) cannot read Telugu
C2_DOCAI_OCR_PROCESSOR_VERSION=pretrained-ocr-v2.1.1-2025-01-31

# Source-document store (ADR-0014): memory (sandbox) or gcs (private raw bucket; synthetic prefix)
C2_DOCUMENT_STORE=memory
C2_GCS_RAW_BUCKET=

# Local docker-compose stack (infrastructure/local). Throwaway dev values only.
POSTGRES_USER=c2
POSTGRES_PASSWORD=
POSTGRES_DB=c2
# Application state (review decisions, confirmed OCR text, audit trail). memory = sandbox default.
C2_STATE_STORE=memory
C2_PG_DSN=
C2_CLOUDSQL_INSTANCE=
C2_CLOUDSQL_USER=
C2_CLOUDSQL_DB=c2

# Mock e-Office sandbox data (ADR-0020): v1 | v2 | both. v2/both need the data root holding the public orders.
C2_SANDBOX_SEED=v1
C2_SANDBOX_PUBLIC_CORPUS_DIR=

# Gemini for conflict types B / G (ADR-0017): none | vertex (live, cached) | recorded (replay only)
C2_LLM_PROVIDER=none
C2_GEMINI_MODEL=gemini-3.5-flash
# Fallback when Gemini is down (ADR-0021): an open model on Ollama on THIS machine; returns to Gemini by itself.
C2_LLM_FALLBACK=none            # none | ollama
C2_OLLAMA_MODEL=                # the model you pulled with `ollama pull …`
C2_OLLAMA_BASE_URL=http://localhost:11434
# Where public-order rungs are read from (ADR-0028): memory | cloud (BigQuery L0-L2 + Cloud SQL L3)
C2_RETRIEVAL_BACKEND=memory
C2_BQ_DATASET=c2_metadata
# L2 embeddings in region (ADR-0026); empty = no BigQuery L2
C2_EMBEDDING_MODEL=
C2_EMBEDDING_DIMENSIONS=768
# Query log (ADR-0029): memory | bigquery (<project>.<C2_BQ_AUDIT_DATASET>.query_log, IDs only)
C2_QUERY_LOG=memory
C2_BQ_AUDIT_DATASET=c2_audit
